# Bulk data: frozen-backbone feature caches and pickled organisms (~8 GB).
# Every number in every document is regenerated by claims.py from
# results/*.json, which IS tracked; the caches are rebuilt by gpu/extract_*.py
# and the organisms rebuild themselves on first run.
results/*.npz
results/*.pkl

# Run logs: the launch scripts write each job's stdout/stderr here. The records
# that matter are results/*.json.
logs/

# Bulk transfers to and from the GPU machine (~5 GB): payload zips, staged
# send-backs and raw output dumps. The write-ups they produced are in docs/.
handoff/
sendback_battery*/
GPUOutput*/
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# LaTeX build products; the built PDFs are tracked
*.aux
*.bbl
*.blg
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
paper/*.log
overview/*.log

# Third-party datasets downloaded by torchvision (~350 MB, re-downloadable)
data/
