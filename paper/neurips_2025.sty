% ---------------------------------------------------------------------------
% STAND-IN for the official neurips_2025.sty (which is distributed by the
% conference, not CTAN). Layout constants below follow the official style
% (10pt, 5.5in x 9in text block, unnumbered-by-default title block, \And
% author separators, ruled abstract). For submission, delete this file and
% drop in the official one; the document source is unchanged.
% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2025}[2026/08/20 stand-in for official NeurIPS style]
\newif\if@preprint\@preprintfalse
\DeclareOption{preprint}{\@preprinttrue}
\DeclareOption{final}{}
\DeclareOption*{}
\ProcessOptions\relax
\usepackage[verbose=true,letterpaper]{geometry}
\geometry{textheight=9in,textwidth=5.5in,top=1in,headheight=12pt,headsep=25pt,footskip=30pt}
\usepackage{times}
\widowpenalty=10000
\clubpenalty=10000
\flushbottom\sloppy
% ------------------------------------------------ title block
\providecommand{\And}{\end{tabular}\hfil\linebreak[0]\hfil%
  \begin{tabular}[t]{c}\rule{\z@}{24pt}\ignorespaces}
\providecommand{\AND}{\end{tabular}\hfil\linebreak[4]\hfil%
  \begin{tabular}[t]{c}\rule{\z@}{24pt}\ignorespaces}
\renewcommand{\maketitle}{%
  \par\begingroup
  \renewcommand{\thefootnote}{\fnsymbol{footnote}}
  \newpage\global\@topnum\z@
  {\centering
   {\LARGE\bf \@title\par}\vskip 0.25in
   {\normalsize
    \begin{tabular}[t]{c}\rule{\z@}{24pt}\ignorespaces\@author\end{tabular}\par}%
   \vskip 0.3in minus 0.1in}
  \if@preprint{\centering\small Preprint. Under review.\par\vskip 0.1in}\fi
  \endgroup\par
  \setcounter{footnote}{0}}
% ------------------------------------------------ abstract
\renewenvironment{abstract}{%
  \vskip 0.075in
  \centerline{\large\bf Abstract}
  \vspace{0.5ex}
  \begin{quote}}{\end{quote}\vskip 1ex}
% ------------------------------------------------ sections
\providecommand{\section@font}{\large\bf}
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex plus -0.5ex minus -0.2ex}{1.5ex plus 0.3ex minus 0.2ex}{\large\bf\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex plus -0.5ex minus -0.2ex}{0.8ex plus 0.2ex}{\normalsize\bf\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex plus -0.5ex minus -0.2ex}{0.5ex plus 0.2ex}{\normalsize\bf\raggedright}}
\endinput
